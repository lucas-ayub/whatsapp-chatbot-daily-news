# Copy to .env and fill in. Never commit .env.

# Your WhatsApp number in international format (with +country code)
CALLMEBOT_PHONE=+55XXXXXXXXXXX
# API key sent to you by CallMeBot after activation (see README)
CALLMEBOT_APIKEY=

# Optional: enables AI curation of news and historical events
ANTHROPIC_API_KEY=
# Optional: override the model set in digest/config.py
# ANTHROPIC_MODEL=claude-sonnet-5-5
